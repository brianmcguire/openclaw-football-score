{
  "name": "@brianmcguire/openclaw-football-score",
  "version": "0.3.0",
  "description": "NFL and NCAA college football scoreboards for OpenClaw. ESPN public feed; no API key needed.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "refresh-dashboard.mjs",
    "openclaw.plugin.json",
    "README.md"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "football",
    "nfl",
    "ncaa",
    "scores"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmcguire/openclaw-football-score.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  }
}
